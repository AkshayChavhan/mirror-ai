# Copy this file to `.env` and fill in real values. Never commit `.env`.
# Every value below is a placeholder in <angle brackets>.

# --- Database (MongoDB Atlas, used by Prisma) ---
# Connection string from Atlas: Cluster → Connect → Drivers.
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority"

# --- Auth (Clerk) ---
# From the Clerk dashboard → API Keys. The publishable key is safe in the browser.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="<clerk-publishable-key>"
# Server-only secret. Never expose it to client code.
CLERK_SECRET_KEY="<clerk-secret-key>"

# --- Image storage (Cloudinary) ---
# From the Cloudinary console → Dashboard → API Keys.
CLOUDINARY_CLOUD_NAME="<cloudinary-cloud-name>"
CLOUDINARY_API_KEY="<cloudinary-api-key>"
# Server-only secret.
CLOUDINARY_API_SECRET="<cloudinary-api-secret>"

# --- Try-on model (Hugging Face) ---
# Access token from huggingface.co → Settings → Access Tokens. Server-only.
# ZeroGPU usage is billed to this token's quota (see docs/phase-0-findings.md).
HF_TOKEN="<hf-token>"

# --- Background jobs (Inngest) ---
# From the Inngest dashboard → Manage → Keys. Server-only. Not needed for local dev with the Inngest dev server.
INNGEST_EVENT_KEY="<inngest-event-key>"
INNGEST_SIGNING_KEY="<inngest-signing-key>"
